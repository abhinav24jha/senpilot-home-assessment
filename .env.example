# Copy to .env and fill values locally. Never commit real credentials.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
JEV_CONFIDENCE_THRESHOLD=0.8
JEV_PROBABILITY_THRESHOLD=0.9
AGENT_FROM=agent@example.test
DATA_DIR=./data
DOWNLOAD_WORKERS=1
MAX_EMAIL_BYTES=2000000
MAX_DOWNLOAD_BYTES=100000000
MAX_ZIP_BYTES=15000000
MAX_MESSAGE_BYTES=22000000
# Local processing writes response.eml. These are needed only for live mailbox use.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Optional: read only requests addressed to this demo alias.
IMAP_RECIPIENT=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
POLL_SECONDS=30
ALLOWED_SENDERS=
